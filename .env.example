# Superteam Certify — environment template.
# Copy to `.env` at the repo root (apps/web/.env.local is a symlink to it —
# see README.md "Why the symlink"). Never commit `.env` itself.

# ---- Chain (devnet) ----
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_WS_URL=wss://api.devnet.solana.com
# Filled by `pnpm seed:onchain` after the program is deployed.
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Privy (https://dashboard.privy.io) ----
# Solana embedded wallets + "return user data in identity token" must both be
# ON in the dashboard for this app id — see WAKEUP.md.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Supabase (https://supabase.com/dashboard) ----
# Paste the project URL, then run `pnpm setup:supabase` — see WAKEUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, but required for `pnpm setup:supabase` to apply migrations
# autonomously (Dashboard -> Connect -> URI). Without it, apply
# supabase/migrations/*.sql by hand in the SQL editor instead.
SUPABASE_DB_URL=

# ---- Server keys (path to a solana-keygen JSON file, or the JSON array
# itself) — see README.md "Key custody" before ever using this in prod ----
NOTARY_SECRET_KEY=.keys/notary.json
OPERATOR_SECRET_KEY=.keys/operator.json
# DEPLOYER doubles as the 2nd distinct admin signer for the destructive op
# class (revoke_certificate / set_notary / add_admin / remove_admin) until
# a human admin's embedded wallet registers — see WAKEUP.md "Custody".
DEPLOYER_SECRET_KEY=.keys/deployer.json

# ---- Roles (server-only; the client learns its role via GET /api/me) ----
ADMIN_EMAILS=
ADMIN_WALLETS=

# ---- UI mock mode (local review only) ----
# Set to 1 to render every screen against fixtures — no Privy, no Supabase, no
# RPC — and pick the role with the on-screen switcher (writes a `mock_role`
# cookie: anon | student | signer | admin | creator; defaults to admin). Ignored
# whenever NODE_ENV=production, so it cannot be turned on in a deployed build.
# See apps/web/README.md "UI mock mode". Leave unset for normal development.
NEXT_PUBLIC_UI_MOCK=

# ---- Metaplex Core ----
# Filled by `pnpm seed:onchain` (creates the one global collection).
CORE_COLLECTION_ADDRESS=

# ---- Helius (optional) ----
# Powers the Helius MCP dev tool (see .mcp.json) — NOT read by the app
# itself, which gets its RPC from NEXT_PUBLIC_RPC_URL/NEXT_PUBLIC_WS_URL
# above. Get a key at https://dev.helius.xyz
HELIUS_API_KEY=

# =============================================================================
# solana-ai-kit MCP keys (pre-existing scaffold; unrelated to Certify itself;
# all optional)
# =============================================================================

# Colosseum Copilot — for startup research skill
# Get a PAT at https://arena.colosseum.org/copilot
COLOSSEUM_COPILOT_PAT=
COLOSSEUM_COPILOT_API_BASE=https://copilot.colosseum.com/api/v1

# QEDGen formal verification — requires qedgen CLI
# Get a key at https://console.mistral.ai
MISTRAL_API_KEY=

# TheGrid — for Colosseum project graph queries
# Get a key at https://thegrid.id
THEGRID_API_KEY=
THEGRID_GRAPHQL_ENDPOINT=https://beta.node.thegrid.id/graphql

# QuickNode — for QuickNode RPC/Streams/DAS
# Get endpoints at https://www.quicknode.com
QUICKNODE_RPC_URL=
QUICKNODE_WSS_URL=
QUICKNODE_API_KEY=

# X/Twitter — for CT alpha research skill
# Get a bearer token at https://developer.x.com
X_BEARER_TOKEN=

# DFlow — for DFlow order flow integration
DFLOW_API_KEY=

# --- Attendance NFTs ---
# Shared Bubblegum v2 Merkle tree (created by `pnpm tree:attendance`; depth 14 / buffer 64 / canopy 8)
# Observed cost per mintV2 (devnet, `pnpm e2e:attendance`, 2026-08-19): 95,000
# lamports (~0.000095 SOL) — Bubblegum protocol fee + base tx fee, paid by
# OPERATOR (participants pay nothing).
ATTENDANCE_MERKLE_TREE=
# Wallets allowed to create attendance events (comma-separated, exact-case base58)
ATTENDANCE_CREATOR_WALLETS=ENn4h8RZGXfXhmU6LQKZtujWjddpvYhT4NXWhNacvHsb,B6pK7Txek2fcQDmNVBCQNB7WvbBfE1qZTWTHE8Bwqb2M
# HMAC secret for the creator session cookie (32+ random bytes, e.g. `openssl rand -base64 32`)
ATTENDANCE_SESSION_SECRET=
